<?xml version="1.0"?>
<sdf version="1.6">
  <world name="smart_community">
    <plugin name="ros_api" filename="libgazebo_ros_api_plugin.so"/>

    <gravity>0 0 -9.8</gravity>
    <physics type="ode">
      <real_time_update_rate>1000</real_time_update_rate>
      <max_step_size>0.001</max_step_size>
    </physics>
    <scene>
      <ambient>0.55 0.55 0.55 1</ambient>
      <background>0.78 0.82 0.86 1</background>
      <shadows>true</shadows>
    </scene>
    <gui fullscreen="0">
      <camera name="user_camera">
        <pose>0 -8.8 9.0 0 0.78 1.5708</pose>
        <view_controller>orbit</view_controller>
      </camera>
    </gui>

    <light name="sun" type="directional">
      <pose>0 0 10 0 0 0</pose>
      <diffuse>0.95 0.95 0.90 1</diffuse>
      <specular>0.25 0.25 0.25 1</specular>
      <direction>-0.4 0.2 -0.9</direction>
    </light>

    <!-- The official field uses the existing 10 m x 10 m coordinate system. -->
    <model name="map_floor">
      <static>true</static>
      <link name="floor">
        <collision name="floor_collision">
          <pose>0 0 0 0 0 0</pose>
          <geometry><box><size>10 10 0.08</size></box></geometry>
          <surface>
            <friction><ode><mu>1.0</mu><mu2>1.0</mu2></ode></friction>
          </surface>
        </collision>
        <visual name="black_floor">
          <pose>0 0 0.005 0 0 0</pose>
          <geometry><box><size>10 10 0.08</size></box></geometry>
          <material><ambient>0.025 0.025 0.025 1</ambient><diffuse>0.025 0.025 0.025 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- White guide lines are 1 mm high visuals only, so they cannot block wheels. -->
    <model name="map_white_lines">
      <static>true</static>
      <link name="lines">
        <visual name="outer_bottom"><pose>0 -4.75 0.041 0 0 0</pose><geometry><box><size>9.5 0.05 0.001</size></box></geometry><material><ambient>1 1 1 1</ambient><diffuse>1 1 1 1</diffuse></material></visual>
        <visual name="outer_top"><pose>0 4.75 0.041 0 0 0</pose><geometry><box><size>9.5 0.05 0.001</size></box></geometry><material><ambient>1 1 1 1</ambient><diffuse>1 1 1 1</diffuse></material></visual>
        <visual name="outer_left"><pose>-4.75 0 0.041 0 0 0</pose><geometry><box><size>0.05 9.5 0.001</size></box></geometry><material><ambient>1 1 1 1</ambient><diffuse>1 1 1 1</diffuse></material></visual>
        <visual name="outer_right"><pose>4.75 0 0.041 0 0 0</pose><geometry><box><size>0.05 9.5 0.001</size></box></geometry><material><ambient>1 1 1 1</ambient><diffuse>1 1 1 1</diffuse></material></visual>
        <visual name="parking_left"><pose>3.0 0 0.041 0 0 0</pose><geometry><box><size>0.05 9.5 0.001</size></box></geometry><material><ambient>1 1 1 1</ambient><diffuse>1 1 1 1</diffuse></material></visual>
        <visual name="parking_slot_1"><pose>3.88 2.55 0.041 0 0 0</pose><geometry><box><size>1.75 0.05 0.001</size></box></geometry><material><ambient>1 1 1 1</ambient><diffuse>1 1 1 1</diffuse></material></visual>
        <visual name="parking_slot_2"><pose>3.88 0.85 0.041 0 0 0</pose><geometry><box><size>1.75 0.05 0.001</size></box></geometry><material><ambient>1 1 1 1</ambient><diffuse>1 1 1 1</diffuse></material></visual>
        <visual name="parking_slot_3"><pose>3.88 -0.85 0.041 0 0 0</pose><geometry><box><size>1.75 0.05 0.001</size></box></geometry><material><ambient>1 1 1 1</ambient><diffuse>1 1 1 1</diffuse></material></visual>
        <visual name="parking_slot_4"><pose>3.88 -2.55 0.041 0 0 0</pose><geometry><box><size>1.75 0.05 0.001</size></box></geometry><material><ambient>1 1 1 1</ambient><diffuse>1 1 1 1</diffuse></material></visual>
        <visual name="people_a_top"><pose>-2.15 3.55 0.041 0 0 0</pose><geometry><box><size>3.3 0.05 0.001</size></box></geometry><material><ambient>1 1 1 1</ambient><diffuse>1 1 1 1</diffuse></material></visual>
        <!-- Official marked A-area width: 3.55 - 2.95 = 0.60 m. -->
        <visual name="people_a_left"><pose>-3.8 3.25 0.041 0 0 0</pose><geometry><box><size>0.05 0.60 0.001</size></box></geometry><material><ambient>1 1 1 1</ambient><diffuse>1 1 1 1</diffuse></material></visual>
        <visual name="people_a_bottom"><pose>-2.15 2.95 0.041 0 0 0</pose><geometry><box><size>3.3 0.05 0.001</size></box></geometry><material><ambient>1 1 1 1</ambient><diffuse>1 1 1 1</diffuse></material></visual>
        <visual name="people_b_top"><pose>-2.45 1.15 0.041 0 0 0</pose><geometry><box><size>2.7 0.05 0.001</size></box></geometry><material><ambient>1 1 1 1</ambient><diffuse>1 1 1 1</diffuse></material></visual>
        <visual name="left_block_left"><pose>-3.8 -1.45 0.041 0 0 0</pose><geometry><box><size>0.05 5.2 0.001</size></box></geometry><material><ambient>1 1 1 1</ambient><diffuse>1 1 1 1</diffuse></material></visual>
        <visual name="left_block_right"><pose>-1.1 -1.45 0.041 0 0 0</pose><geometry><box><size>0.05 5.2 0.001</size></box></geometry><material><ambient>1 1 1 1</ambient><diffuse>1 1 1 1</diffuse></material></visual>
        <!-- Official marked bottom width: -4.15 - (-4.75) = 0.60 m. -->
