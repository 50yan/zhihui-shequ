        <visual name="central_left"><pose>0.55 0.0 0.041 0 0 0</pose><geometry><box><size>0.05 7.0 0.001</size></box></geometry><material><ambient>1 1 1 1</ambient><diffuse>1 1 1 1</diffuse></material></visual>
