<launch>
  <arg name="gui" default="true"/>
  <arg name="run_explorer" default="true"/>
  <arg name="world" default="$(find zhihui_shequ_sim)/worlds/smart_community_0_10.world"/>
  <arg name="explorer_config" default="$(find zhihui_shequ_sim)/config/mapping_route_0_10.yaml"/>

  <include file="$(find zhihui_shequ_sim)/launch/simulation_base.launch">
    <arg name="gui" value="$(arg gui)"/>
    <arg name="world" value="$(arg world)"/>
  </include>

  <node name="slam_gmapping" pkg="gmapping" type="slam_gmapping" output="screen">
    <param name="base_frame" value="base_footprint"/>
    <param name="odom_frame" value="odom"/>
    <param name="map_frame" value="map"/>
    <param name="map_update_interval" value="1.0"/>
    <param name="maxUrange" value="10.0"/>
    <param name="maxRange" value="12.0"/>
    <param name="minimumScore" value="50"/>
    <param name="linearUpdate" value="0.10"/>
    <param name="angularUpdate" value="0.10"/>
    <param name="temporalUpdate" value="0.50"/>
    <param name="particles" value="40"/>
    <param name="xmin" value="-6.0"/>
    <param name="ymin" value="-6.0"/>
    <param name="xmax" value="6.0"/>
    <param name="ymax" value="6.0"/>
    <param name="delta" value="0.05"/>
  </node>

  <node if="$(arg run_explorer)"
        name="mapping_explorer"
        pkg="zhihui_shequ_sim"
        type="mapping_explorer.py"
        output="screen">
    <param name="config" value="$(arg explorer_config)"/>
  </node>
</launch>
